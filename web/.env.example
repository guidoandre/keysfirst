# Devnet RPC endpoint. A free dedicated devnet key (e.g. Helius) avoids public rate limits during the demo.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional, server-only. A private RPC for the API routes and the daily cron; falls back to NEXT_PUBLIC_RPC_URL.
RPC_URL=
# Test EUR mint address, written to web/.env.local by `npm run create-test-eur -- <APP_URL>`.
NEXT_PUBLIC_MINT=
# Server-only. JSON array secret key of the devnet faucet wallet: Test EUR mint authority, pays SOL top-ups and signs
# the daily return of expired deposits. Written by `npm run create-test-eur`. Never commit or share.
FAUCET_SECRET_KEY=
# Privy app id (dashboard.privy.io → App settings → Basics). Public: identifies the app, not a secret.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only. Stripe TEST secret key (sk_test_…). The server refuses live keys.
STRIPE_SECRET_KEY=
# Stripe TEST publishable key (pk_test_…) for the card form on the deal page. Public. Live keys are refused.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only. Any long random string. Vercel Cron sends it to /api/cron/return-deposits (daily return of expired deposits).
CRON_SECRET=
